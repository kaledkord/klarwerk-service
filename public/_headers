# Netlify-Header (Spiegel der [[headers]] in netlify.toml – beide gleich halten).
# HTML ohne eigenen Header: Netlify liefert "max-age=0, must-revalidate" mit ETag.

# Gehashte Build-Dateien: ein Jahr, unveränderlich
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Selbst gehostete Schrift
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Optimierte Fotos (AVIF/WebP/JPEG)
/bilder/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=604800

# Logos, Favicons, Originalfotos, Video
/logos/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/*.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/*.jpg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/*.svg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/*.webp
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/*.mp4
  Cache-Control: public, max-age=604800, stale-while-revalidate=604800
  Accept-Ranges: bytes

# Sicherheit für alle Antworten
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
